{
  "name": "beautiflow",
  "version": "0.9.0",
  "description": "Render, arrange, audit, and polish Mermaid diagrams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpuig/beautiflow.git"
  },
  "homepage": "https://beautiflow.cc/",
  "bugs": {
    "url": "https://github.com/mpuig/beautiflow/issues"
  },
  "type": "module",
  "private": true,
  "bin": {
    "beautiflow": "./src/cli.ts"
  },
  "scripts": {
    "build": "bun run ./scripts/patch-jsdom.ts && bun build ./src/cli.ts --compile --minify --bytecode --sourcemap --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile ./dist/beautiflow",
    "build:docs": "bun run ./scripts/build-docs.ts",
    "build:site": "bun run ./scripts/build-site.ts",
    "build:contact-sheet": "bun run ./scripts/build-contact-sheet.ts",
    "preview:site": "bun run ./scripts/build-site.ts --serve",
    "check": "bunx tsc --noEmit",
    "clean": "rm -rf dist",
    "dev": "bun run ./src/cli.ts",
    "test": "bun test",
    "validate": "bun run check && bun test && bun run build && bun run build:docs && bun run build:contact-sheet"
  },
  "dependencies": {
    "@iconify-json/logos": "1.2.13",
    "@iconify-json/lucide": "1.2.126",
    "@napi-rs/canvas": "1.0.8",
    "@resvg/resvg-js": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "elkjs": "0.11.0",
    "jsdom": "27.0.1",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsdom": "27.0.0",
    "marked": "16.4.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
