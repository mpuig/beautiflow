erDiagram
    MEMBER ||--o{ LOAN : borrows
    BOOK ||--o{ COPY : includes
    COPY ||--o{ LOAN : appears_in
    AUTHOR }o--o{ BOOK : writes

    MEMBER {
        string member_id
        string display_name
        date joined_on
    }
    BOOK {
        string isbn
        string title
        int publication_year
    }
    COPY {
        string copy_id
        string condition
    }
    LOAN {
        date checked_out
        date due_on
    }
    AUTHOR {
        string author_id
        string name
    }
