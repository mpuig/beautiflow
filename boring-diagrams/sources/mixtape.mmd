architecture-beta
%% Fictional cross-account publishing. Masters and unpublished renditions are not public CDN origins.
%% @boundary ingestion account
%% @boundary ingestRegion region
%% @boundary processing account
%% @boundary processingRegion region
%% @boundary publishAccount account
%% @boundary publishRegion region
%% @boundary archiveAccount account
%% @boundary archiveRegion region
group ingestion(cloud)[Account: Artist ingestion]
group ingestRegion(cloud)[Region: Primary] in ingestion
group processing(cloud)[Account: Audio processing]
group processingRegion(cloud)[Region: Primary] in processing
group publishAccount(cloud)[Account: Publication]
group publishRegion(cloud)[Region: Primary] in publishAccount
group archiveAccount(cloud)[Account: Master archive]
group archiveRegion(cloud)[Region: Recovery] in archiveAccount
service auth(aws:cognito)[Artist identity] in ingestRegion
service broker(aws:lambda)[Scoped upload broker] in ingestRegion
service masters(aws:s3)[Quarantined masters] in ingestRegion
service submit(aws:step-functions)[Authorized job workflow] in processingRegion
service encode(lucide:audio-lines)[MediaConvert jobs] in processingRegion
service staged(aws:s3)[Unpublished renditions] in processingRegion
service approve(aws:lambda)[Rights and release gate] in publishRegion
service published(aws:s3)[Approved playback files] in publishRegion
service catalogue(aws:dynamodb)[Published catalogue] in publishRegion
service cdn(aws:cloudfront)[Signed CloudFront playback] in publishAccount
service archive(aws:s3)[Versioned master replica] in archiveRegion
%% @edge auth broker identity | Verified artist subject maps to an allowed tenant prefix; client-supplied object keys are not authority.
auth:R --> L:broker
%% @edge broker masters identity | Broker grants a short-lived upload capability scoped to a server-selected object key; browser performs the upload.
broker:R --> L:masters
%% @edge masters submit event | Configured S3 EventBridge forwarding starts the cross-account workflow under a constrained role.
masters:R --> L:submit
%% @edge submit encode control | Scoped role submits an asynchronous job with explicit cross-account source bucket and KMS permissions.
submit:R --> L:encode
%% @edge encode staged request | Writes derived renditions; a completed file alone is not a published recording.
encode:R --> L:staged
%% @edge staged approve control | Successful job event plus human rights approval unlocks release; this is workflow progression, not S3 granting rights.
staged:B --> T:approve
%% @edge approve published request | Release service copies approved assets through explicit cross-account read and destination write policies.
approve:L --> T:published
%% @edge approve catalogue request | Catalogue becomes visible only after successful approved asset publication; reconciliation handles partial failures.
approve:B --> L:catalogue
%% @edge cdn published request | Origin access control and source-distribution bucket policy permit private reads; requests use signed viewer URLs.
cdn:R --> B:published
%% @edge masters archive replication | Cross-account, cross-region S3 replication with versioning and KMS grants; deletion and retention policies are explicit configuration.
masters:B --> L:archive
